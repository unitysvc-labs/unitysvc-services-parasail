{
  "time_created": "{{ time_created }}",
{#- Model-family logo (unitysvc/unitysvc-data#60): the catalog row shows the
    model's own mark rather than the provider's — the model is what a customer
    recognises, and the provider is already named beside it. Resolved from the
    model id, so no per-model parameter is needed and the populate script
    cannot destroy it. A model the registry does not know resolves to null,
    which creates no document and leaves the provider logo in place, so the key
    needs no conditional. -#}
  "logo": {{ {"$logo_preset": offering_name} | tojson }},
  "name": "{{ offering_name }}",
  "display_name": "{{ display_name }}",
{#- summary = marketplace teaser (<=200 chars, required by unitysvc#1838);
    description = long-form detail + how-to + interop paragraphs.
    The populate script emits an empty/one-line brief; the Anthropic/OpenAI
    dual-dialect sentence only applies to chat models. #}
{#- Keyed on the platform capability, NOT on service_type. `derive_service_type`
    files BAAI/bge-m3 and parasail-bge-m3 as `llm` (their names contain no
    "embed"), so `service_type == 'llm'` is true for two embedding services —
    which made them render the Anthropic-dialect chat examples and the
    dual-dialect copy. Those examples POST a chat body at /v1/embeddings and
    400, and code examples count toward the activation gate, not just the
    connectivity test. -#}
{%- set _is_chat = (capability | default('chat', true)) == 'chat' %}
{%- set _base = description | default(display_name ~ ' — a ' ~ service_type ~ ' model served by ' ~ provider_display_name, true) %}
{%- set _dual = ' — callable in both OpenAI and Anthropic API styles through the UnitySVC gateway.' %}
{%- set _brief = (_base ~ _dual) if ((_base | length) + (_dual | length) < 195) else _base %}
{%- if not _brief %}{%- set _brief = display_name ~ ' — a ' ~ service_type ~ ' model served by ' ~ provider_display_name %}{%- endif %}
{%- set _ctx = ' with a ' ~ details.context_length ~ '-token context window' if details.context_length else '' %}
{%- set _detail = display_name ~ ' is served by ' ~ provider_display_name ~ ' over an OpenAI-compatible API' ~ _ctx ~ '. Requests are proxied through the UnitySVC gateway and billed per token.' %}
{%- set _howto = 'Reach it through the UnitySVC gateway on either channel: managed (the default) resells ' ~ provider_display_name ~ ' tokens at the listed rate, or byok, where you supply your own ' ~ provider_display_name ~ ' API key and pay ' ~ provider_display_name ~ ' directly.' %}
{%- if _is_chat %}{%- set _howto = _howto ~ ' See the code examples for both styles.' %}{%- endif %}
{#- Dedicated interoperability paragraph: the dual-dialect endpoint is the
    platform differentiator and what makes services interchangeable enough to
    sit behind the gateway's composition primitives. #}
{%- set _interop = 'One endpoint, either dialect — send an OpenAI Chat Completions or an Anthropic Messages request and the gateway auto-detects the format, translates it for the upstream, and replies in the style you sent. Because every model on UnitySVC speaks both dialects, they are interchangeable behind a single client: swap providers without touching your code, and combine them with the gateway composition primitives — group (/g/), broadcast (/b/), chain (/c/) and failover (/f/).' %}
{%- set _summary = (_brief.split('\n\n')[0] | trim)[:200] %}
{%- set _description = _detail ~ '\n\n' ~ _howto ~ '\n\n' ~ _interop %}
  "summary": {{ _summary | tojson }},
  "description": {{ _description | tojson }},
  "service_type": "{{ service_type }}",
{#- Platform capability vocabulary (unitysvc docs/capabilities.yml) — what the
    caller GETS. Not a map of service_type: `derive_service_type` deliberately
    collapses TTS and transcription models into `llm` (those values are not
    valid server-side), so the modality keywords are re-tested here. The
    populator writes `capability` into every param file; this reproduces it for
    a param file that predates that. -#}
{%- set _n = offering_name | lower %}
{%- set _cap = capability | default(
      "rerank" if "rerank" in _n
      else ("text-to-speech" if ("tts" in _n or "text-to-speech" in _n)
      else ("speech-to-text" if ("whisper" in _n or "transcribe" in _n)
      else {"embedding": "embed", "image_generation": "image-generate"}.get(service_type, "chat"))), true) %}
  "capabilities": ["{{ _cap }}"],
  "status": "{{ status | default('ready') }}",
  "currency": "USD",
{#- Tags are a CLOSED vocabulary server-side (unitysvc docs/tags.yml): ingest
    rejects anything outside it, and `feature:func-call` is the only tag a
    seller may declare. The legacy ai/gateway/byok trio restated service_type,
    gateway_type and the enrollment channel — all platform-derived — so it is
    gone rather than translated. The tag is gated on _is_chat as well as the
    flag because a non-chat model must never claim tool calling: parasail-bge-m3
    and BAAI/bge-m3 are embeddings that carry supports_tools=true (the populator
    defaults the flag to true; see below), and a func-call tag there would ship
    a tools code example that 400s at /v1/embeddings. -#}
{%- if _is_chat and supports_tools | default(false) %}
  "tags": ["feature:func-call"],
{%- endif %}
{#- Formats are a service-level fact for every chat model: an OpenAI-compatible
    upstream exposed in both dialects via the llm_translator below (callers may
    send OpenAI or Anthropic; responses come back in kind). Embeddings and other
    non-chat types have no translator and no dual formats. #}
{%- if _is_chat %}
{%- set _details = details.copy() %}
{%- set _ = _details.update({"input_formats": ["openai", "anthropic"], "output_formats": ["openai_response", "anthropic_response"]}) %}
  "details": {{ _details | tojson }},
{%- else %}
  "details": {{ details | tojson }},
{%- endif %}
{%- if payout_price %}
  "payout_price": {{ payout_price | tojson }},
{%- endif %}
{#- Parasail resells its own tokens, so both channels front the same upstream and
    differ only in whose key pays: managed = seller key (${ secrets.* }),
    byok = customer key (${ customer_secrets.* }). Channel TYPE is derived from
    that alone (no flag). llm_translator (chat only) lets the OpenAI upstream also
    serve Anthropic-style callers; the gateway auto-detects and only translates
    when the incoming dialect differs. base_url is unversioned and preserved as-is. #}
  "upstream_access_config": {
    "managed": {
      "access_method": "http",
      "api_key": "${ secrets.{{ env_api_key_name }} }",
      "base_url": "{{ api_base_url }}",
      "rate_limits": [
        {
          "description": "Requests per minute",
          "limit": 60,
          "unit": "requests",
          "window": "minute"
        },
        {
          "description": "Input tokens per minute",
          "limit": 100000,
          "unit": "input_tokens",
          "window": "minute"
        },
        {
          "description": "Output tokens per minute",
          "limit": 10000,
          "unit": "output_tokens",
          "window": "minute"
        }
      ],
      "routing_key": {
        "model": "{{ offering_name }}"
      },
{%- if _is_chat %}
      "request_transformer": {"llm_translator": "anthropic_to_openai"},
{%- endif %}
      "sort_order": 1
    },
    "byok": {
      "access_method": "http",
      "api_key": "${ customer_secrets.{{ env_api_key_name }} }",
      "base_url": "{{ api_base_url }}",
      "rate_limits": [
        {
          "description": "Requests per minute",
          "limit": 60,
          "unit": "requests",
          "window": "minute"
        },
        {
          "description": "Input tokens per minute",
          "limit": 100000,
          "unit": "input_tokens",
          "window": "minute"
        },
        {
          "description": "Output tokens per minute",
          "limit": 10000,
          "unit": "output_tokens",
          "window": "minute"
        }
      ],
      "routing_key": {
        "model": "{{ offering_name }}"
      },
{%- if _is_chat %}
      "request_transformer": {"llm_translator": "anthropic_to_openai"},
{%- endif %}
      "sort_order": 2
    }
  }
}
