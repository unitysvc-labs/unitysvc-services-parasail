{#- Capability-driven example dispatch. Keyed on the platform capability
    rather than service_type, because `derive_service_type` cannot see every
    embedding model (BAAI/bge-m3 has no "embed" in its name) and forces TTS
    into `llm`. The capability is the thing the examples must match. -#}
{%- set _cap = capability | default("chat", true) %}
{
  "time_created": "{{ time_created }}",
  "name": "{{ service_name }}",
  "status": "{{ status | default('ready') }}",
  "currency": "USD",
{#- Keyed on the platform capability, NOT on service_type. `derive_service_type`
    files BAAI/bge-m3 and parasail-bge-m3 as `llm` (their names contain no
    "embed"), so `service_type == 'llm'` is true for two embedding services —
    which made them render the Anthropic-dialect chat examples and the
    dual-dialect copy. Those examples POST a chat body at /v1/embeddings and
    400, and code examples count toward the activation gate, not just the
    connectivity test. -#}
{%- set _is_chat = (capability | default('chat', true)) == 'chat' %}
{%- if list_price %}
  {#- Channel-keyed price: byok is free (the customer's own key pays Parasail
      directly); managed resells Parasail tokens at the per-model rate carried in
      the param `list_price`. Channel keys MUST match the offering channels.

      Price-cell copy follows the marketplace description grammar
      (unitysvc/unitysvc#1886, PR #1887):

          <amount> [ ("/"|"per") <unit> ] [ "~"[intent] <badge> ]* [ "|" <note> ]

      The description that matters is the one on the CHANNEL price, not the
      sub-channel ones. CatalogServiceRow hands the whole `list_price` to
      PriceTag, and PriceTag is the only component that parses a description;
      the sub-channel prices reach ChannelDisplay's PriceBadge, which prints
      whatever it is given verbatim. A channel-keyed price carrying neither a
      top-level `description` nor a top-level `price` falls through PriceTag's
      structured branch to `isFree`, so every metered model in this catalog
      renders a green "Free" today. Naming the default channel's rate here is
      the fix — and PriceTag's own docstring says channel prices "should set a
      description" for exactly this reason.

      No badge, deliberately. The row already carries a byok access-method chip
      (AccessMethodBadges renders one per channel type), so a "BYOK" pill here
      would duplicate an affordance the row already has — and the amount beside
      it is the *managed* rate, so a bare `~` badge, which is the green "this
      is a saving" register, would misdescribe the number it sits next to. The
      byok alternative goes in the `|` note instead. That slot is terminal and
      taken verbatim, so it is free to contain "/" and "per" without being
      re-parsed as a unit.

      Composed here rather than written into the param file because
      scripts/update_params.py rebuilds `list_price` on the nightly populate
      run (.github/workflows/populate-services.yml, 02:00 UTC) and would drop a
      hand-edited description within a day. `payout_price` is seller-facing and
      shares that script's wording — it is rendered by offering.json.j2 and is
      deliberately untouched here. #}
{%- set _byok_note = ' | Free on the byok channel - bring your own ' ~ provider_display_name ~ ' key and pay ' ~ provider_display_name ~ ' directly.' %}
{#- Parasail prices input and output separately, so the catalog rate cell has to
    name both. `list_price.description` is authored in update_params.build_price
    and is already in the parsed price-tag grammar, so it is used as-is rather
    than restated here. `.get()` not `.price`: the env is StrictUndefined, where
    a bare attribute miss raises instead of being falsy. The single-`price`
    branch remains for any param file predating the input/output split. #}
{%- set _managed_rate = list_price.description if list_price.get('input')
      else (('$' ~ list_price.price ~ ' / 1M tokens') if list_price.get('price') else '') %}
  "list_price": {
    "type": "channel",
    "default": "managed",
{%- if _managed_rate %}
    "description": {{ (_managed_rate ~ _byok_note) | tojson }},
{%- endif %}
    "channels": {
      "byok": {
        "description": "Free — bring your own {{ provider_display_name }} API key; you pay {{ provider_display_name }} directly for tokens",
        "price": "0",
        "type": "constant"
      },
      {#- Split input/output prices carry their own description already. The
          blended fallback still needs restating: "Pricing Per 1M Tokens" names
          a unit and no number, so it parses to the amount "Pricing" with the
          unit "1M Tokens" and the rate never appears. #}
      "managed": {{ (list_price if list_price.get('input')
                     else dict(list_price, description='$' ~ list_price.price ~ ' per 1M tokens')) | tojson }}
    }
  },
{%- endif %}
  "user_access_interfaces": {
    "provider_api": {
      "access_method": "http",
      "base_url": "${API_GATEWAY_BASE_URL}/{{ provider_name }}",
      "routing_key": {"model": "{{ offering_name }}"}
    }
  },
  {#- sleep_after_test spaces out the executed docs against upstream rate limits.
      llm_description declares no executed request and is left bare. #}
  {#- Every document below is DERIVED from what this service is: its
      capability and the request dialects it accepts (unitysvc/unitysvc#1899).
      The catalog-wide shape lives in unitysvc-data's `llm_example_collection`
      preset, so a new example flavour or a fixed preset reaches this repo on
      the next release rather than through a PR here.

      A collection covers ONE capability, so `_cap` still chooses the branch —
      and it now picks the connectivity probe as a consequence rather than
      through the inline `'llm_connectivity_embed' if _cap == 'embed'`
      conditional this block used to carry. -#}
  "documents": {
{#- The audio branches. Without them every non-embed service fell through to
    chat, so `parasail-resemble-tts-en` — a `ready` TTS service — was handed the
    chat collection and tested against /chat/completions: 30 examples, 30
    failures, none of them about the service. The offering already declared
    `capabilities: ["text-to-speech"]` correctly; only the document selection
    was wrong.

    Both audio capabilities carry a full example set AND a connectivity probe as
    of unitysvc-data 0.1.40 (`llm_connectivity_transcription`,
    `llm_connectivity_tts`), so the collection resolves each on its own now.
    `formats: ["openai"]` because neither speaks the Anthropic dialect, and no
    `tools` for the same reason. -#}
{%- if _cap == "text-to-speech" %}
    "$llm_example_collection": {
      "capabilities": ["text-to-speech"],
      "formats": ["openai"],
      "upstream_dialect": "openai",
      "sleep": 5
    }
{%- elif _cap == "speech-to-text" %}
    "$llm_example_collection": {
      "capabilities": ["speech-to-text"],
      "formats": ["openai"],
      "upstream_dialect": "openai",
      "sleep": 5
    }
{%- elif _cap == "embed" %}
    "$llm_example_collection": {
      "capabilities": ["embed"],
      "formats": ["openai"],
      "upstream_dialect": "openai",
      "sleep": 5
    }
{%- else %}
    "$llm_example_collection": {
      "capabilities": ["chat"],
      "formats": ["openai", "anthropic"],
      "upstream_dialect": "openai",
      {#- Parasail's API reports supports_tools=null for every model, so the
          repo's default of true is preserved rather than newly narrowed. -#}
      "tools": {{ (supports_tools | default(true)) | tojson }},
      "sleep": 5
    }
{%- endif %}
  }
}
